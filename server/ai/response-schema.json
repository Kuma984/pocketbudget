{
  "type": "object",
  "additionalProperties": false,
  "required": ["intent"],
  "properties": {
    "intent": {"enum": ["expense_summary", "simulate_purchase", "draft_transaction", "unsupported"]},
    "item_name": {"type": "string", "maxLength": 120},
    "price_vnd": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "period": {"type": "string", "pattern": "^(this_month|last_month|[1-9][0-9]{3}-(0[1-9]|1[0-2]))$"},
    "category_code": {"type": "string", "enum": ["food", "transport", "study", "shopping", "entertainment", "health", "other_expense"]},
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["income", "expense", "transfer"]},
        "amount_vnd": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "category_code": {"type": "string", "enum": ["allowance", "salary", "scholarship", "other_income", "food", "transport", "study", "shopping", "entertainment", "health", "other_expense"]},
        "occurred_on": {"type": "string", "pattern": "^[1-9][0-9]{3}-[0-9]{2}-[0-9]{2}$"},
        "note": {"type": "string", "maxLength": 500}
      }
    }
  }
}
